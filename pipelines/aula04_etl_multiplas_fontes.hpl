  <transform>
    <type>Formula</type>
    <name>Calcular KPIs</name>
    <formulas>
      <formula>
        <field_name>taxa_pass_pct</field_name>
        <formula>([total_pass]/[total_testados])*100</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>taxa_fail_pct</field_name>
        <formula>([total_fail]/[total_testados])*100</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>aderencia_meta_pct</field_name>
        <formula>([total_dentro_meta]/[total_testados])*100</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>atingiu_meta_qualidade</field_name>
        <formula>IF([taxa_pass_pct]&gt;=[meta_pass_pct],"SIM","NAO")</formula>
        <value_type>2</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
    </formulas>

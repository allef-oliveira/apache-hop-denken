  <transform>
    <type>Formula</type>
    <name>Calcular indicadores do registro</name>
    <formulas>
      <formula>
        <field_name>desvio_meta_segundos</field_name>
        <formula>[tempo_ciclo_segundos]-[meta_ciclo_segundos]</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>percentual_tempo_meta</field_name>
        <formula>([tempo_ciclo_segundos]/[meta_ciclo_segundos])*100</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>flag_pass</field_name>
        <formula>IF([status]="PASS",1,0)</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>flag_fail</field_name>
        <formula>IF([status]="FAIL",1,0)</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>flag_dentro_meta</field_name>
        <formula>IF([tempo_ciclo_segundos]&lt;=[meta_ciclo_segundos],1,0)</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>classificacao_operacional</field_name>
        <formula>IF(OR([status]="FAIL",[tempo_ciclo_segundos]&gt;[meta_ciclo_segundos]*1.2),"CRITICO","NORMAL")</formula>
        <value_type>2</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
    </formulas>
